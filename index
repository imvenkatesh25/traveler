<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Travel Explorer</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="index" href="index.css">
</head>

<body class="bg-slate-50 text-slate-800">

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- Hero / Destination Search -->
        <section class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-700 p-6 sm:p-10 text-white shadow-xl">

            <div class="relative z-10 max-w-3xl">
                <span class="inline-block mb-3 rounded-full bg-white/20 px-4 py-1 text-sm backdrop-blur">
                    ✈️ Explore the world
                </span>

                <h1 class="text-3xl sm:text-5xl font-bold tracking-tight">
                    Discover your next adventure
                </h1>

                <p class="mt-3 text-blue-100 text-sm sm:text-lg">
                    Find tourist attractions, hotels and the best ways to reach your destination.
                </p>

                <!-- Search Box -->
                <div class="mt-7 flex flex-col sm:flex-row gap-3">

                    <div class="relative flex-1">
                        <i data-lucide="map-pin"
                           class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5">
                        </i>

                        <input
                            id="destination"
                            type="text"
                            placeholder="Enter your destination..."
                            class="w-full rounded-xl border-0 bg-white py-4 pl-12 pr-4 text-slate-800 outline-none ring-2 ring-transparent focus:ring-white"
                        />
                    </div>

                    <button
                        onclick="searchDestination()"
                        class="rounded-xl bg-white px-7 py-4 font-semibold text-blue-700 transition hover:bg-blue-50 active:scale-95">
                        Explore
                    </button>
                </div>
            </div>

            <!-- Decorative circle -->
            <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/10"></div>
            <div class="absolute -bottom-32 right-20 h-80 w-80 rounded-full bg-white/10"></div>
        </section>


        <!-- Results -->
        <section id="results" class="mt-10">

            <!-- Destination Title -->
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-6">
                <div>
                    <p class="text-sm font-medium text-blue-600">
                        TRAVEL RECOMMENDATIONS
                    </p>

                    <h2 class="text-2xl sm:text-3xl font-bold">
                        Explore <span id="destinationName">Goa</span>
                    </h2>
                </div>

                <button class="text-sm font-medium text-blue-600 hover:underline">
                    View all recommendations →
                </button>
            </div>


            <!-- ================= TOURIST SPOTS ================= -->

            <div class="mb-12">

                <div class="flex items-center justify-between mb-5">
                    <h3 class="text-xl font-bold flex items-center gap-2">
                        <i data-lucide="landmark" class="w-5 h-5 text-blue-600"></i>
                        Nearby Tourist Spots
                    </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

                    <!-- Spot 1 -->
                    <article class="group overflow-hidden rounded-2xl bg-white shadow-sm border border-slate-200 hover:shadow-lg transition">

                        <div class="relative h-52 overflow-hidden">
                            <img
                                src="https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=900&q=80"
                                alt="Tourist attraction"
                                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                            >

                            <span class="absolute top-3 right-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold">
                                2.4 km
                            </span>
                        </div>

                        <div class="p-5">
                            <h4 class="font-bold text-lg">
                                Heritage Palace
                            </h4>

                            <p class="mt-1 text-sm text-slate-500">
                                Historic architecture and beautiful surroundings.
                            </p>

                            <div class="mt-4 flex items-center justify-between">
                                <span class="flex items-center gap-1 text-sm text-slate-500">
                                    <i data-lucide="clock" class="w-4 h-4"></i>
                                    2–3 hours
                                </span>

                                <button class="text-sm font-semibold text-blue-600">
                                    Details →
                                </button>
                            </div>
                        </div>
                    </article>


                    <!-- Spot 2 -->
                    <article class="group overflow-hidden rounded-2xl bg-white shadow-sm border border-slate-200 hover:shadow-lg transition">

                        <div class="relative h-52 overflow-hidden">
                            <img
                                src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=900&q=80"
                                alt="Beach destination"
                                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                            >

                            <span class="absolute top-3 right-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold">
                                5.8 km
                            </span>
                        </div>

                        <div class="p-5">
                            <h4 class="font-bold text-lg">
                                Sunset Beach
                            </h4>

                            <p class="mt-1 text-sm text-slate-500">
                                Relax, enjoy the ocean and watch the sunset.
                            </p>

                            <div class="mt-4 flex items-center justify-between">
                                <span class="flex items-center gap-1 text-sm text-slate-500">
                                    <i data-lucide="clock" class="w-4 h-4"></i>
                                    3–4 hours
                                </span>

                                <button class="text-sm font-semibold text-blue-600">
                                    Details →
                                </button>
                            </div>
                        </div>
                    </article>


                    <!-- Spot 3 -->
                    <article class="group overflow-hidden rounded-2xl bg-white shadow-sm border border-slate-200 hover:shadow-lg transition">

                        <div class="relative h-52 overflow-hidden">
                            <img
                                src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=900&q=80"
                                alt="Nature destination"
                                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                            >

                            <span class="absolute top-3 right-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold">
                                8.1 km
                            </span>
                        </div>

                        <div class="p-5">
                            <h4 class="font-bold text-lg">
                                Green Valley
                            </h4>

                            <p class="mt-1 text-sm text-slate-500">
                                A peaceful nature destination for outdoor lovers.
                            </p>

                            <div class="mt-4 flex items-center justify-between">
                                <span class="flex items-center gap-1 text-sm text-slate-500">
                                    <i data-lucide="clock" class="w-4 h-4"></i>
                                    Half day
                                </span>

                                <button class="text-sm font-semibold text-blue-600">
                                    Details →
                                </button>
                            </div>
                        </div>
                    </article>

                </div>
            </div>


            <!-- ================= HOTELS ================= -->

            <div class="mb-12">

                <div class="flex items-center justify-between mb-5">
                    <h3 class="text-xl font-bold flex items-center gap-2">
                        <i data-lucide="hotel" class="w-5 h-5 text-blue-600"></i>
                        Best Hotel Recommendations
                    </h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

                    <!-- Hotel 1 -->
                    <article class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden hover:shadow-lg transition">

                        <div class="relative">
                            <img
                                src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=900&q=80"
                                alt="Luxury hotel"
                                class="h-48 w-full object-cover"
                            >

                            <span class="absolute top-3 left-3 rounded-lg bg-emerald-500 px-3 py-1 text-sm font-bold text-white">
                                ₹4,500/night
                            </span>
                        </div>

                        <div class="p-5">

                            <div class="flex justify-between gap-3">
                                <h4 class="font-bold text-lg">
                                    Ocean View Resort
                                </h4>

                                <span class="flex items-center gap-1 text-sm font-semibold">
                                    ⭐ 4.8
                                </span>
                            </div>

                            <p class="mt-2 text-sm text-slate-500">
                                Premium rooms with scenic views and modern facilities.
                            </p>

                            <button class="mt-4 w-full rounded-xl bg-slate-100 py-3 text-sm font-semibold hover:bg-blue-50 hover:text-blue-600 transition">
                                View Hotel
                            </button>

                        </div>
                    </article>


                    <!-- Hotel 2 -->
                    <article class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden hover:shadow-lg transition">

                        <div class="relative">
                            <img
                                src="https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?auto=format&fit=crop&w=900&q=80"
                                alt="Modern hotel"
                                class="h-48 w-full object-cover"
                            >

                            <span class="absolute top-3 left-3 rounded-lg bg-emerald-500 px-3 py-1 text-sm font-bold text-white">
                                ₹3,200/night
                            </span>
                        </div>

                        <div class="p-5">

                            <div class="flex justify-between gap-3">
                                <h4 class="font-bold text-lg">
                                    City Comfort Hotel
                                </h4>

                                <span class="flex items-center gap-1 text-sm font-semibold">
                                    ⭐ 4.5
                                </span>
                            </div>

                            <p class="mt-2 text-sm text-slate-500">
                                Comfortable rooms close to major tourist attractions.
                            </p>

                            <button class="mt-4 w-full rounded-xl bg-slate-100 py-3 text-sm font-semibold hover:bg-blue-50 hover:text-blue-600 transition">
                                View Hotel
                            </button>

                        </div>
                    </article>


                    <!-- Hotel 3 -->
                    <article class="rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden hover:shadow-lg transition">

                        <div class="relative">
                            <img
                                src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=900&q=80"
                                alt="Boutique hotel"
                                class="h-48 w-full object-cover"
                            >

                            <span class="absolute top-3 left-3 rounded-lg bg-emerald-500 px-3 py-1 text-sm font-bold text-white">
                                ₹2,400/night
                            </span>
                        </div>

                        <div class="p-5">

                            <div class="flex justify-between gap-3">
                                <h4 class="font-bold text-lg">
                                    Palm Garden Stay
                                </h4>

                                <span class="flex items-center gap-1 text-sm font-semibold">
                                    ⭐ 4.3
                                </span>
                            </div>

                            <p class="mt-2 text-sm text-slate-500">
                                Affordable stay surrounded by gardens and greenery.
                            </p>

                            <button class="mt-4 w-full rounded-xl bg-slate-100 py-3 text-sm font-semibold hover:bg-blue-50 hover:text-blue-600 transition">
                                View Hotel
                            </button>

                        </div>
                    </article>

                </div>
            </div>


            <!-- ================= TRANSPORT ================= -->

            <div>

                <div class="mb-5">
                    <h3 class="text-xl font-bold flex items-center gap-2">
                        <i data-lucide="navigation" class="w-5 h-5 text-blue-600"></i>
                        How to Get There
                    </h3>

                    <p class="mt-1 text-sm text-slate-500">
                        Choose the most convenient way to reach your destination.
                    </p>
                </div>


                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

                    <!-- Flight -->
                    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-lg transition">

                        <div class="flex items-center justify-between">

                            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                                <i data-lucide="plane" class="w-6 h-6"></i>
                            </div>

                            <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-600">
                                Fastest
                            </span>

                        </div>

                        <h4 class="mt-5 text-lg font-bold">
                            Flight
                        </h4>

                        <div class="mt-3 space-y-2 text-sm text-slate-500">
                            <p>📍 Chennai Airport</p>
                            <p>↓</p>
                            <p>📍 Goa International Airport</p>
                        </div>

                        <div class="mt-5 flex justify-between border-t pt-4">
                            <span class="text-sm">Duration</span>
                            <strong>1h 15m</strong>
                        </div>

                    </div>


                    <!-- Train -->
                    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-lg transition">

                        <div class="flex items-center justify-between">

                            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                                <i data-lucide="train" class="w-6 h-6"></i>
                            </div>

                            <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-600">
                                Comfortable
                            </span>

                        </div>

                        <h4 class="mt-5 text-lg font-bold">
                            Train
                        </h4>

                        <div class="mt-3 space-y-2 text-sm text-slate-500">
                            <p>📍 Chennai Central</p>
                            <p>↓</p>
                            <p>📍 Madgaon Station</p>
                        </div>

                        <div class="mt-5 flex justify-between border-t pt-4">
                            <span class="text-sm">Duration</span>
                            <strong>12h 30m</strong>
                        </div>

                    </div>


                    <!-- Car / Bus -->
                    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-lg transition">

                        <div class="flex items-center justify-between">

                            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                                <i data-lucide="car" class="w-6 h-6"></i>
                            </div>

                            <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-600">
                                Flexible
                            </span>

                        </div>

                        <h4 class="mt-5 text-lg font-bold">
                            Car / Bus
                        </h4>

                        <div class="mt-3 space-y-2 text-sm text-slate-500">
                            <p>📍 Your Location</p>
                            <p>↓</p>
                            <p>📍 Goa</p>
                        </div>

                        <div class="mt-5 flex justify-between border-t pt-4">
                            <span class="text-sm">Duration</span>
                            <strong>10–12h</strong>
                        </div>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- JavaScript -->
    <script src="index.js"></script>
</body>
</html>
